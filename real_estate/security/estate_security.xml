<odoo>
  <data noupdate="1">

    <!-- A category groups related groups together in the
         Users & Companies > Groups admin screen -->
    <record id="module_category_real_estate" model="ir.module.category">
      <field name="name">Real Estate</field>
    </record>

    <!-- New in Odoo 19: groups no longer link to a category
         directly. Instead they link to a "privilege", and the
         privilege links to the category. -->
    <record id="privilege_real_estate" model="res.groups.privilege">
      <field name="name">Real Estate</field>
      <field name="category_id" ref="module_category_real_estate"/>
    </record>

    <!-- Base group: everyday agents -->
    <record id="group_estate_salesperson" model="res.groups">
      <field name="name">Salesperson</field>
      <field name="privilege_id" ref="privilege_real_estate"/>
    </record>

    <!-- Manager group: implied_ids means every Manager
         automatically also belongs to Salesperson, inheriting
         all its access rights automatically -->
    <record id="group_estate_manager" model="res.groups">
      <field name="name">Manager</field>
      <field name="privilege_id" ref="privilege_real_estate"/>
      <field name="implied_ids" eval="[(4, ref('group_estate_salesperson'))]"/>
    </record>

    <!-- Restrict Salespeople to only see properties where
         they are the assigned salesperson. Managers are
         technically ALSO members of this group (via
         implied_ids above), so without the override rule
         below, they'd be restricted too. -->
    <record id="estate_property_rule_salesperson" model="ir.rule">
      <field name="name">Salesperson: only own properties</field>
      <field name="model_id" ref="model_estate_property"/>
      <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_estate_salesperson'))]"/>
    </record>

    <!-- Managers see ALL properties, unrestricted. Odoo
         combines multiple rules on the same model with OR
         logic, so a Manager (member of both groups) ends up
         with: (salesperson_id = user.id) OR (1 = 1), which
         simplifies to "no restriction at all". -->
    <record id="estate_property_rule_manager" model="ir.rule">
      <field name="name">Manager: see all properties</field>
      <field name="model_id" ref="model_estate_property"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_estate_manager'))]"/>
    </record>

  </data>
</odoo>