<odoo>
  <data>

    <!-- List view -->
    <record model="ir.ui.view" id="estate_property_list_view">
      <field name="name">estate.property.list</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
        <list decoration-success="best_price &gt;= expected_price"
              decoration-warning="best_price &gt; 0 and best_price &lt; expected_price"
              decoration-muted="best_price == 0">
          <field name="name" string="Property"/>
          <field name="property_type_id" widget="badge"/>
          <field name="postcode"/>
          <field name="bedrooms"/>
          <field name="living_area" string="Area (m²)"/>
          <field name="garden" widget="boolean_toggle"/>
          <field name="garage" widget="boolean_toggle"/>
          <field name="expected_price"/>
          <field name="rent_price" string="Rent/mo"/>
          <field name="best_price"/>
          <field name="selling_price"/>
          <field name="date_availability"/>
        </list>
      </field>
    </record>

    <!-- Kanban view -->
    <record model="ir.ui.view" id="estate_property_kanban_view">
      <field name="name">estate.property.kanban</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
        <kanban class="o_kanban_mobile">
          <field name="name"/>
          <field name="property_type_id"/>
          <field name="expected_price"/>
          <field name="rent_price"/>
          <field name="best_price"/>
          <field name="bedrooms"/>
          <field name="living_area"/>
          <field name="garden"/>
          <field name="garage"/>
          <field name="garden_orientation"/>
          <field name="google_map_link"/>
          <field name="image_1920"/>
          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click o_kanban_card p-0 mb-3 shadow-sm rounded overflow-hidden">
                <img t-if="record.image_1920.raw_value"
                     t-attf-src="/web/image/estate.property/{{record.id.raw_value}}/image_1920"
                     class="w-100" style="height:140px;object-fit:cover;"/>

                <div class="p-3 text-bg-primary">
                  <div class="d-flex justify-content-between align-items-center">
                    <strong class="fs-5"><field name="name"/></strong>
                    <span class="badge text-bg-light text-primary" t-if="record.property_type_id.raw_value">
                      <field name="property_type_id"/>
                    </span>
                  </div>
                </div>

                <div class="p-3">
                  <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">
                      <i class="fa fa-bed me-1"/><field name="bedrooms"/> beds
                    </span>
                    <span class="text-muted">
                      <i class="fa fa-arrows-alt me-1"/><field name="living_area"/> m²
                    </span>
                  </div>

                  <div class="mb-2">
                    <span t-if="record.garden.raw_value" class="badge text-bg-success me-1">
                      <i class="fa fa-tree me-1"/>Garden
                    </span>
                    <span t-if="record.garage.raw_value" class="badge text-bg-info me-1">
                      <i class="fa fa-car me-1"/>Garage
                    </span>
                    <span t-if="record.garden_orientation.raw_value" class="badge text-bg-secondary">
                      <i class="fa fa-compass me-1"/><field name="garden_orientation"/>
                    </span>
                  </div>

                  <div class="d-flex justify-content-between align-items-end border-top pt-2">
                    <div>
                      <div class="text-muted small">Expected</div>
                      <div class="fw-bold"><field name="expected_price"/></div>
                    </div>
                    <div class="text-end">
                      <div class="text-muted small">Rent/mo</div>
                      <div class="fw-bold text-info"><field name="rent_price"/></div>
                    </div>
                  </div>

                  <a t-if="record.google_map_link.raw_value"
                     t-att-href="record.google_map_link.raw_value"
                     target="_blank"
                     class="btn btn-sm btn-outline-secondary mt-2 w-100"
                     onclick="event.stopPropagation()">
                    <i class="fa fa-map-marker me-1"/>View on map
                  </a>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- Form view -->
    <record model="ir.ui.view" id="estate_property_form_view">
      <field name="name">estate.property.form</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <widget name="web_ribbon" title="Garden" bg_color="text-bg-success" invisible="not garden"/>
            <widget name="web_ribbon" title="Garage" bg_color="text-bg-info" invisible="not garage"/>

            <field name="image_1920" widget="image" class="oe_avatar"/>

            <div class="oe_title">
              <h1><field name="name" placeholder="e.g. Cozy Beachside Villa"/></h1>
              <h3 class="text-muted">
                <field name="property_type_id" placeholder="Property Type"/>
              </h3>
            </div>

            <group>
              <group string="Details">
                <field name="description"/>
                <field name="postcode"/>
                <field name="date_availability"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <field name="google_map_link" widget="url" string="Location (Google Maps)"/>
              </group>

              <group string="Pricing">
                <field name="expected_price"/>
                <field name="best_price"/>
                <field name="selling_price"/>
                <field name="rent_price" string="Monthly Rent"/>
                <field name="salesperson_id"/>
              </group>
            </group>

            <group string="Outdoor">
              <group>
                <field name="garage" widget="boolean_toggle"/>
                <field name="garden" widget="boolean_toggle"/>
              </group>
              <group invisible="not garden">
                <field name="garden_area"/>
                <field name="garden_orientation" widget="radio" options="{'horizontal': true}"/>
              </group>
            </group>

            <notebook>
              <page string="Offers">
                <div class="p-3">
                  <h5 class="mb-3">Offers</h5>
                  <field name="offer_ids" nolabel="1">
                    <list editable="bottom"
                          default_order="status"
                          decoration-success="status == 'accepted'"
                          decoration-danger="status == 'refused'">
                      <field name="price"/>
                      <field name="partner_id" widget="many2one_avatar"/>
                      <field name="status" column_invisible="1"/>

                      <!-- Accept button: only shows while the offer
                           is still pending (no status set yet) -->
                      <button name="action_accept" type="object" string="Accept"
                              class="btn-success" icon="fa-check" invisible="status != False"
                              title="Accept this offer"
                              groups="real_estate.group_estate_manager,real_estate.group_estate_salesperson"/>

                      <!-- Refuse button: same condition -->
                      <button name="action_refuse" type="object" string="Refuse"
                              class="btn-danger" icon="fa-times" invisible="status != False"
                              title="Refuse this offer"
                              groups="real_estate.group_estate_manager,real_estate.group_estate_salesperson"/>

                      <!-- Visual confirmation of the outcome once decided -->
                      <field name="status" widget="badge"
                             decoration-success="status == 'accepted'"
                             decoration-danger="status == 'refused'"/>
                    </list>
                  </field>
                </div>
              </page>
              <page string="Photos">
                <field name="property_image_ids">
                  <kanban>
                    <field name="image"/>
                    <field name="name"/>
                    <templates>
                      <t t-name="card">
                        <div class="o_kanban_image_full p-1">
                          <field name="image" widget="image" class="w-100 rounded"/>
                          <div t-if="record.name.raw_value" class="text-center small text-muted mt-1">
                            <field name="name"/>
                          </div>
                        </div>
                      </t>
                    </templates>
                  </kanban>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Search view -->
    <record model="ir.ui.view" id="estate_property_search_view">
      <field name="name">estate.property.search</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
        <search string="Search Properties">
          <field name="name"/>
          <field name="postcode"/>
          <field name="property_type_id"/>
          <field name="expected_price"/>

          <filter string="With Garden" name="has_garden" domain="[('garden', '=', True)]"/>
          <filter string="With Garage" name="has_garage" domain="[('garage', '=', True)]"/>

          <searchpanel>
            <field name="property_type_id" icon="fa-building" enable_counters="1"/>
          </searchpanel>
        </search>
      </field>
    </record>

    <!-- Pivot view -->
    <record model="ir.ui.view" id="estate_property_pivot_view">
      <field name="name">estate.property.pivot</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
        <pivot string="Properties Analysis">
          <field name="property_type_id" type="row"/>
          <field name="garden_orientation" type="col"/>
          <field name="expected_price" type="measure"/>
          <field name="best_price" type="measure" operator="max"/>
          <field name="selling_price" type="measure"/>
        </pivot>
      </field>
    </record>

    <!-- Action -->
    <record model="ir.actions.act_window" id="estate_property_action_window">
      <field name="name">Properties</field>
      <field name="res_model">estate.property</field>
      <field name="view_mode">kanban,list,pivot,form</field>
      <field name="search_view_id" ref="estate_property_search_view"/>
      <field name="context">{}</field>
    </record>

  </data>
</odoo>