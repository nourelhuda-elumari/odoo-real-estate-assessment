<odoo>
  <data>

    <!-- ============================================= -->
    <!-- The actual PDF layout, as a QWeb template       -->
    <!-- ============================================= -->
    <template id="report_estate_property_document">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="property">
          <t t-call="web.external_layout">
            <div class="page">
              <h2>
                <span t-field="property.name"/>
              </h2>
              <p t-if="property.property_type_id">
                Type: <span t-field="property.property_type_id.name"/>
              </p>
              <table class="table table-sm">
                <tr>
                  <td>Bedrooms</td>
                  <td><span t-field="property.bedrooms"/></td>
                </tr>
                <tr>
                  <td>Living Area</td>
                  <td><span t-field="property.living_area"/> m²</td>
                </tr>
                <tr>
                  <td>Expected Price</td>
                  <td><span t-field="property.expected_price"/></td>
                </tr>
                <tr t-if="property.selling_price">
                  <td>Selling Price</td>
                  <td><span t-field="property.selling_price"/></td>
                </tr>
                <tr t-if="property.garden">
                  <td>Garden</td>
                  <td>
                    <span t-field="property.garden_area"/> m²,
                    <span t-field="property.garden_orientation"/> facing
                  </td>
                </tr>
              </table>
            </div>
          </t>
        </t>
      </t>
    </template>

    <!-- ============================================= -->
    <!-- The action that ties a Print button to the      -->
    <!-- template above                                  -->
    <!-- ============================================= -->
    <record id="action_report_estate_property" model="ir.actions.report">
      <field name="name">Property Listing</field>
      <field name="model">estate.property</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">real_estate.report_estate_property_document</field>
      <field name="report_file">real_estate.report_estate_property_document</field>
      <field name="print_report_name">'Property - %s' % (object.name)</field>
      <field name="binding_model_id" ref="model_estate_property"/>
      <field name="binding_type">report</field>
    </record>

  </data>
</odoo>